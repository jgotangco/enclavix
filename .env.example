# Copy to .env.local for a mock-only local demo. Never add Supabase keys in demo mode.
ENCLAVIX_APP_ENV=demo
NEXT_PUBLIC_APP_ENV=demo
# Production mode enables account services only; it cannot enter mock business screens.
# ENCLAVIX_APP_ENV=production
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY

# Private downloads only: inject SUPABASE_SERVICE_ROLE_KEY at runtime, never into demo or builds.
